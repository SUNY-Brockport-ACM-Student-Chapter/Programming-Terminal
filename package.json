{
    "name": "@edually/programming-terminal",
    "version": "1.2.1",
    "description": "An embeddable React code editor and interactive terminal for programming exercises.",
    "keywords": [
        "code-editor",
        "codemirror",
        "education",
        "react",
        "terminal",
        "xterm"
    ],
    "main": "./frontend/dist/programming-terminal.cjs",
    "module": "./frontend/dist/programming-terminal.js",
    "types": "./frontend/dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SUNY-Brockport-ACM-Student-Chapter/Programming-Terminal.git"
    },
    "homepage": "https://github.com/SUNY-Brockport-ACM-Student-Chapter/Programming-Terminal#readme",
    "bugs": {
        "url": "https://github.com/SUNY-Brockport-ACM-Student-Chapter/Programming-Terminal/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "files": [
        "frontend/dist"
    ],
    "exports": {
        ".": {
            "types": "./frontend/dist/index.d.ts",
            "import": "./frontend/dist/programming-terminal.js",
            "require": "./frontend/dist/programming-terminal.cjs"
        },
        "./styles.css": "./frontend/dist/programming-terminal.css"
    },
    "scripts": {
        "dev": "concurrently \"npm run dev --prefix frontend\" \"npm run dev --prefix execution-server\"",
        "build": "npm run build --prefix frontend",
        "install:all": "npm install --prefix frontend && npm install --prefix execution-server"
    },
    "devDependencies": {
        "concurrently": "^10.0.3"
    },
    "dependencies": {
        "react-resizable-panels": "^4.11.2"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    }
}
